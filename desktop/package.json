{
  "name": "gale-desktop",
  "productName": "Gale",
  "version": "0.1.0",
  "description": "Gale for computers: draw and animate, and keep your iPad and iPhone in sync.",
  "author": "Stormblazerplayz",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stormblazerplayz/Gale.git"
  },
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "start": "node scripts/bundle.js && electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "node scripts/bundle.js && electron-builder",
    "dist:win": "node scripts/bundle.js && electron-builder --win"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "electron-updater": "6.8.11",
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "gifenc": "1.0.3"
  },
  "build": {
    "appId": "com.stormblazerplayz.gale.desktop",
    "productName": "Gale",
    "copyright": "Stormblazerplayz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "build/icon.png",
      "src/**/*",
      "!src/**/*.map"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gale"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Stormblazerplayz",
        "repo": "Gale",
        "releaseType": "release"
      }
    ]
  }
}
